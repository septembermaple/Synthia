{
  "name": "synthia-api",
  "version": "1.0.0",
  "description": "Synthia API - Cloudflare Workers",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create synthia-db",
    "db:migrate": "wrangler d1 execute synthia-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute synthia-db --local --file=./schema.sql"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
