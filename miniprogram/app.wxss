page {
  min-height: 100%;
  background: #f6f7fb;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.btn {
  height: 88rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary {
  background: #111827;
  color: #ffffff;
}

.btn-secondary {
  background: #eef2ff;
  color: #3730a3;
}

.btn-danger {
  background: #fee2e2;
  color: #991b1b;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.picker {
  height: 84rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 14rpx;
  background: #ffffff;
  color: #111827;
  font-size: 28rpx;
  line-height: 84rpx;
}

.muted {
  color: #6b7280;
}

.error {
  margin-top: 18rpx;
  color: #b91c1c;
  font-size: 26rpx;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #6b7280;
  font-size: 28rpx;
}
