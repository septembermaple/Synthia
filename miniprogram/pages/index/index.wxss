.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.points,
.login-mini {
  min-width: 132rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #111827;
  color: #ffffff;
  text-align: center;
  line-height: 64rpx;
  font-size: 24rpx;
}

.panel {
  box-sizing: border-box;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-title {
  margin-bottom: 22rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.upload-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.thumb-wrap,
.add-tile {
  position: relative;
  height: 190rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.thumb-wrap.active {
  outline: 4rpx solid #111827;
}

.thumb {
  width: 100%;
  height: 100%;
}

.add-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #9ca3af;
  color: #4b5563;
  font-size: 64rpx;
}

.primary-tag,
.remove {
  position: absolute;
  top: 10rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.86);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 38rpx;
}

.primary-tag {
  left: 10rpx;
}

.remove {
  right: 10rpx;
}

.settings-row {
  display: flex;
  gap: 18rpx;
}

.half {
  flex: 1;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 0 28rpx;
  color: #374151;
  font-size: 28rpx;
}

.result-card {
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.result-image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 18rpx;
  background: #e5e7eb;
}
