.empty-profile,
.user-card,
.panel {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.user-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.phone {
  margin-bottom: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.score {
  font-size: 54rpx;
  font-weight: 900;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.action {
  margin-top: 18rpx;
}

.message {
  margin-top: 18rpx;
  color: #2563eb;
  font-size: 26rpx;
}

.tx {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
}

.tx:last-child {
  border-bottom: 0;
}

.tx-desc {
  margin-bottom: 6rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.tx-amount {
  font-size: 30rpx;
  font-weight: 800;
}

.small {
  font-size: 24rpx;
}

.logout {
  margin-top: 20rpx;
}
